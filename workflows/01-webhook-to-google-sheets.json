{
  "name": "Webhook to Google Sheets (demo)",
  "nodes": [
    {
      "id": "n1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "demo-intake",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "00000000-0000-4000-8000-000000000001"
    },
    {
      "id": "n2",
      "name": "Validate & Normalize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Validate and normalize the incoming payload.\nconst body = $input.first().json.body ?? $input.first().json;\nconst errors = [];\nconst email = String(body.email ?? '').trim().toLowerCase();\nconst name = String(body.name ?? '').trim();\nif (!/^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email)) errors.push('email is missing or invalid');\nif (!name) errors.push('name is required');\nconst amount = Number(body.amount ?? 0);\nif (Number.isNaN(amount)) errors.push('amount must be a number');\nreturn [{ json: {\n  valid: errors.length === 0,\n  errors,\n  row: {\n    received_at: new Date().toISOString(),\n    name: name.replace(/\\s+/g, ' '),\n    email,\n    amount: Number.isNaN(amount) ? 0 : Math.round(amount * 100) / 100,\n    source: String(body.source ?? 'webhook').slice(0, 50)\n  }\n}}];"
      }
    },
    {
      "id": "n3",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "n4",
      "name": "Append Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        660,
        -100
      ],
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "received_at": "={{ $json.row.received_at }}",
            "name": "={{ $json.row.name }}",
            "email": "={{ $json.row.email }}",
            "amount": "={{ $json.row.amount }}",
            "source": "={{ $json.row.source }}"
          }
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account (placeholder)"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "n5",
      "name": "Respond 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        -160
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"ok\", \"email\": $json.email } }}",
        "options": {
          "responseCode": 200
        }
      }
    },
    {
      "id": "n6",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        120
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"error\", \"errors\": $('Validate & Normalize').item.json.errors } }}",
        "options": {
          "responseCode": 400
        }
      }
    },
    {
      "id": "n7",
      "name": "Respond 502 (Sheets failed)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        880,
        0
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"error\", \"errors\": [\"could not write to Google Sheets\"] } }}",
        "options": {
          "responseCode": 502
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Validate & Normalize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate & Normalize": {
      "main": [
        [
          {
            "node": "Is Valid?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Valid?": {
      "main": [
        [
          {
            "node": "Append Row",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 400",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Append Row": {
      "main": [
        [
          {
            "node": "Respond 200",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond 502 (Sheets failed)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
